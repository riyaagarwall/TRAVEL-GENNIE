# Your secret OpenAI API key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: custom base URL if using an OpenAI-compatible proxy or alternate endpoint (leave blank for official OpenAI)
OPENAI_BASE_URL=

# The AI model to use for generating itineraries (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional fallback model to retry once if the AI service is busy or overloaded
# OPENAI_FALLBACK_MODEL=gpt-4o-mini

# Maximum number of retry attempts for failed AI requests (default: 1)
# OPENAI_MAX_RETRIES=1

# Request timeout in seconds for AI calls (default: 60)
# OPENAI_TIMEOUT_SECONDS=60

# Optional reasoning effort for reasoning models (e.g. low, medium, high)
# OPENAI_REASONING_EFFORT=low

# Enable Flask debug mode for local development (1 for on, 0 for off; default: 0)
# FLASK_DEBUG=1

# Rate limit for itinerary generation per visitor IP per minute (default: 3)
# PLAN_LIMIT_PER_MINUTE=3

# Rate limit for itinerary generation per visitor IP per day (default: 10)
# PLAN_LIMIT_PER_DAY=10
