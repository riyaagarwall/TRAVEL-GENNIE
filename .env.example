# Your secret OpenAI API key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: custom base URL if using an OpenAI-compatible proxy or alternate endpoint (leave blank for official OpenAI)
OPENAI_BASE_URL=

# The AI model to use for generating itineraries (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
